#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

struct Vertex { vec3 pos; vec3 normal; vec2 uv; };
struct Meshlet { uint vOff; uint tOff; uint vCount; uint tCount; uint textureID; };

layout(location = 3) out vec4 fragCurrentPosClip[];
layout(location = 4) out vec4 fragPrevPosClip[];

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer VertexBuffer { Vertex v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer MeshletBuffer { Meshlet m[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer IndexBuffer { uint i[]; };

layout(push_constant) uniform PushConstants {
    mat4 mvp;
    mat4 model;
    mat4 prevMvp;
    uint64_t vBuf;
    uint64_t mBuf;
    uint64_t iBuf;
    uint64_t bBuf;
    uint64_t matBuf;
    uint totalMeshlets;
    uint textureOffset;
    vec2 jitter;
} pc;

// 找回快递包裹！
struct TaskPayload { uint meshletIndices[64]; };
taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 fragNormal[];
layout(location = 1) out vec2 fragUV[];
layout(location = 2) flat out uint fragTexID[];

void main() {
    //从包裹里拿到真正存活的 meshletID，而不是自己算！
    uint meshletID = payload.meshletIndices[gl_WorkGroupID.x]; 
    uint tid = gl_LocalInvocationID.x;

    if (meshletID >= pc.totalMeshlets) return;

    MeshletBuffer mBuf = MeshletBuffer(pc.mBuf);
    Meshlet meshlet = mBuf.m[meshletID];

    SetMeshOutputsEXT(meshlet.vCount, meshlet.tCount);

    if (tid < meshlet.vCount) {
        VertexBuffer vBuf = VertexBuffer(pc.vBuf);
        Vertex vertex = vBuf.v[meshlet.vOff + tid];

        vec4 unjitteredClipPos = pc.mvp * vec4(vertex.pos, 1.0);
    
        // 2. 将纯净的坐标传给 Velocity 计算 (保证速度无误差)
        fragCurrentPosClip[tid] = unjitteredClipPos;
        fragPrevPosClip[tid]    = pc.prevMvp * vec4(vertex.pos, 1.0);
        
        // ★ 3. 数学魔法：应用 Jitter 偏移，用来画这帧的真实几何体位置！
        vec4 jitteredClipPos = unjitteredClipPos;
        jitteredClipPos.xy += pc.jitter * jitteredClipPos.w; // 手动偏移
        
        gl_MeshVerticesEXT[tid].gl_Position = jitteredClipPos;
        
        fragNormal[tid] = normalize(mat3(pc.model) * vertex.normal);
        fragUV[tid] = vertex.uv;
        fragTexID[tid] = meshlet.textureID; // 传递身份证
    }

    IndexBuffer iBuf = IndexBuffer(pc.iBuf);
    for (uint i = tid; i < meshlet.tCount; i += 64) {
        uint indexOffset = meshlet.tOff + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            iBuf.i[indexOffset + 0], 
            iBuf.i[indexOffset + 1], 
            iBuf.i[indexOffset + 2]
        );
    }
}